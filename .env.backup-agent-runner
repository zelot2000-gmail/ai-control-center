# ============================================================
# AI Control Center — Environment Variables Example
# Copy to .env and fill in your values
# DO NOT commit .env to version control
# ============================================================

# --- General ---
ENVIRONMENT=wsl
APP_VERSION=0.1.0
LOG_LEVEL=INFO
WORKSPACE_PATH=/workspace

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aicc
POSTGRES_USER=aicc_user
POSTGRES_PASSWORD=change_me_postgres_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=aicc_docs

# --- Mobile Gateway ---
MOBILE_GATEWAY_PORT=8088
MOBILE_GATEWAY_SECRET=change_me_gateway_secret

# --- RAG API ---
RAG_API_PORT=8090
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- TTO API ---
TTO_API_PORT=8091
TTO_MAX_INPUT_LENGTH=32000
TTO_CLI_PATH=

# --- RTK Bridge ---
RTK_BRIDGE_PORT=8092
RTK_ALLOW_RUN_COMMAND=false
RTK_WORKSPACE=/workspace

# --- Worker ---
WORKER_PORT=8095
HERMES_CLI_PATH=
AGENTUNIVERSE_CLI_PATH=

# --- Webhook Gateway ---
WEBHOOK_GATEWAY_PORT=8093
WEBHOOK_SECRET=change_me_webhook_secret

# --- Observer ---
OBSERVER_PORT=8094

# --- Web Dashboard ---
WEB_DASHBOARD_PORT=3000

# --- Activepieces (optional) ---
AP_PORT=8080
AP_ENCRYPTION_KEY=change_me_ap_encryption_key
AP_JWT_SECRET=change_me_ap_jwt_secret
AP_DB_URL=postgresql://aicc_user:change_me_postgres_password@postgres:5432/aicc

# --- Security ---
API_KEY_HEADER=X-API-Key
INTERNAL_API_KEY=change_me_internal_api_key
